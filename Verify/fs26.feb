 <MeshDomains>
  <SolidDomain name="BottomWall" mat="Wall"/>
  <SolidDomain name="Fluid" mat="Blood"/>
  <SolidDomain name="TopWall" mat="Wall"/>
 </MeshDomains>
 <Boundary>
  <!-- plane strain: no out-of-plane motion -->
  <bc name="PlaneStrain" type="zero displacement" node_set="AllNodeSet">
   <x_dof>0</x_dof><y_dof>0</y_dof><z_dof>1</z_dof>
  </bc>
  <bc name="PlaneFlow" type="zero fluid velocity" node_set="FluidNodes">
   <wx_dof>0</wx_dof><wy_dof>0</wy_dof><wz_dof>1</wz_dof>
  </bc>
  <!-- no-slip on the fluid-wall interface (w = fluid velocity relative to the wall) -->
  <bc name="NoSlip" type="zero fluid velocity" node_set="InterfaceNodes">
   <wx_dof>1</wx_dof><wy_dof>1</wy_dof><wz_dof>1</wz_dof>
  </bc>
  <bc name="OutletResistance" type="fluid resistance" surface="Outlet">
   <R>40</R>
   <pressure_offset>0</pressure_offset>
  </bc>
 </Boundary>
 <Loads>
  <!-- inflow relative to the (possibly moving) inlet; negative = into the domain.
       Imposed weakly (flux only) so it follows the rotating inlet: the nodal
       option (prescribe_nodal_velocities=1) fixes the velocity direction to the
       reference normal, which is not frame-indifferent. -->
  <surface_load name="Inflow" type="fluid normal velocity" surface="Inlet">
   <velocity lc="1">-20</velocity>
   <prescribe_nodal_velocities>0</prescribe_nodal_velocities>
   <parabolic>0</parabolic>
   <prescribe_rim_pressure>1</prescribe_rim_pressure>
  </surface_load>
  <surface_load name="FSITraction" type="fluid-FSI traction" surface="FSInterface"/>
  <surface_load name="OutletBackflow" type="fluid backflow stabilization" surface="Outlet">
   <beta>1</beta>
  </surface_load>
  <!-- frame-indifferent Robin support of the outer wall (perivascular tethering) -->
  <surface_load name="TissueSupport" type="Robin BC" surface="OuterWall">
   <normal_stiffness>3e4</normal_stiffness>
   <tangential_stiffness>5e3</tangential_stiffness>
   <normal_damping>20</normal_damping>
   <tangential_damping>5</tangential_damping>
   <external_pressure>0</external_pressure>
   <objective_rate>1</objective_rate>
   <anchor_center>10.0,2.0,0.5</anchor_center>
   <anchor_translation lc="2">2.0,3.0,0</anchor_translation>
   <anchor_rotation lc="3">0,0,0.3</anchor_rotation>
  </surface_load>
  <!-- ALE mesh of the fluid inlet/outlet sections: tie them (penalty) to the same
       anchor, so the end sections follow the tissue motion instead of being
       pushed around by the fluid pressure -->
  <surface_load name="FluidEndsSupport" type="Robin BC" surface="FluidEnds">
   <normal_stiffness>1e6</normal_stiffness>
   <tangential_stiffness>1e6</tangential_stiffness>
   <objective_rate>1</objective_rate>
   <anchor_center>10.0,2.0,0.5</anchor_center>
   <anchor_translation lc="2">2.0,3.0,0</anchor_translation>
   <anchor_rotation lc="3">0,0,0.3</anchor_rotation>
  </surface_load>
 </Loads>

<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  fs26.feb: FSI in a compliant channel tethered to surrounding tissue (translating + rotating anchor).
  Plane-strain slab (one element through z). Fluid (blood-like) flows between two
  hyperelastic walls; the outer wall surfaces are attached to an external anchor
  through the frame-indifferent Robin support ("Robin BC").
  fs25 and fs26 are identical except for the anchor motion: expressed in the
  anchor frame, the wall deflection and fluid pressure of fs26 should match fs25
  (up to small inertial effects of the moving frame).
  Units: mm, s, g  (stress/pressure in Pa).
-->
<febio_spec version="4.0">
 <Module type="fluid-FSI"/>
 <Control>
  <analysis>DYNAMIC</analysis>
  <time_steps>100</time_steps>
  <step_size>0.01</step_size>
  <plot_level>PLOT_MAJOR_ITRS</plot_level>
  <solver type="fluid-FSI">
   <max_refs>15</max_refs>
   <diverge_reform>1</diverge_reform>
   <reform_each_time_step>1</reform_each_time_step>
   <dtol>0.001</dtol>
   <vtol>0.001</vtol>
   <ftol>0.001</ftol>
   <etol>0.01</etol>
   <rtol>0.001</rtol>
   <rhoi>0.5</rhoi>
   <qn_method type="Broyden"><max_ups>50</max_ups></qn_method>
  </solver>
  <time_stepper type="default">
   <max_retries>8</max_retries>
   <opt_iter>12</opt_iter>
   <dtmin>0.0005</dtmin>
   <dtmax>0.01</dtmax>
  </time_stepper>
 </Control>
 <Material>
  <material id="1" name="Blood" type="fluid-FSI">
   <fluid type="fluid">
    <density>1.06e-3</density>
    <k>2.2e6</k>
    <viscous type="Newtonian fluid"><mu>3.5e-3</mu><kappa>0</kappa></viscous>
   </fluid>
   <solid type="neo-Hookean"><density>0</density><E>100</E><v>0.3</v></solid>
  </material>
  <material id="2" name="Wall" type="neo-Hookean">
   <density>1.1e-3</density><E>5e5</E><v>0.45</v>
  </material>
 </Material>
 <Mesh>
  <Nodes name="AllNodes">
   <node id="1">0,-0.5,0</node>
